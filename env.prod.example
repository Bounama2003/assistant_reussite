# Assistant Réussite — PRODUCTION
# Copier dans Settings > Repository Secrets
# Space HF : assistant-reussite-api (branch main)

SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...production-service-role-key
DATABASE_URL=postgresql://postgres:xxxx@db.your-production-project.supabase.co:6543/postgres
GROQ_API_KEY=gsk_your-production-key
GROQ_MODEL=llama-3.3-70b-versatile
VAPID_PUBLIC_KEY=your-production-vapid-public
VAPID_PRIVATE_KEY=your-production-vapid-private
SUPER_ADMIN_KEY=CHANGE-ME-strong-production-key
ALLOWED_ORIGINS=https://user-assistant-reussite-ui.hf.space
LOG_LEVEL=INFO
LEGACY_HASH_FOR_TESTS=False
SENTRY_DSN=https://key@oXXXX.ingest.de.sentry.io/XXXXX
