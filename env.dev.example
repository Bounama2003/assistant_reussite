# Assistant Réussite — DEV / STAGING
# Copier dans Settings > Repository Secrets
# Space HF : assistant-reussite-api-dev (branch dev)

SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...dev-service-role-key
DATABASE_URL=postgresql://postgres:xxxx@db.your-dev-project.supabase.co:6543/postgres
GROQ_API_KEY=gsk_your-dev-key
GROQ_MODEL=llama-3.3-70b-versatile
VAPID_PUBLIC_KEY=your-dev-vapid-public
VAPID_PRIVATE_KEY=your-dev-vapid-private
SUPER_ADMIN_KEY=CHANGE-ME-dev-key
ALLOWED_ORIGINS=https://user-assistant-reussite-ui-dev.hf.space
LOG_LEVEL=DEBUG
LEGACY_HASH_FOR_TESTS=False
SENTRY_DSN=
